# cmake -DIN=<file> -DOUT=<header> -DNAME=<symbol> -P embed.cmake
# Writes <header> with `static const unsigned char NAME[]` holding IN's bytes
# and `static const size_t NAME_len`, so a file is compiled into the core with
# no tool beyond CMake (the same on every platform the core builds for).
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" hex_len)
math(EXPR len "${hex_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
file(WRITE "${OUT}" "/* generated by cmake/embed.cmake from ${IN} */\n#include <stddef.h>\n"
    "static const unsigned char ${NAME}[] = {\n${bytes}\n};\nstatic const size_t ${NAME}_len = ${len};\n")
